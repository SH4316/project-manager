# --- core (web) ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0

# 앞단 리버스 프록시(NginxProxyManager·Cloudflare Tunnel)가 붙는 도메인.
# `web`는 compose 내부 호출용(mcp·discord가 http://web:8000 으로 부른다). 빼면 그 요청이 400이 된다.
ALLOWED_HOSTS=project.dorm.sio2.kr,web
CSRF_TRUSTED_ORIGINS=https://project.dorm.sio2.kr
# 초대 링크·태스크 바로가기·GitHub OAuth 콜백이 전부 이 주소로 만들어진다.
SITE_URL=https://project.dorm.sio2.kr

POSTGRES_PASSWORD=change-me

# 호스트 쪽 포트. 앞단 프록시가 붙는 포트에 맞춘다(운영 서버는 8080). 둘이 겹치면 기동이 안 된다.
WEB_PORT=8000
MCP_PORT=8080

# --- cloudflared (profile: tunnel) ---
# 외부 리버스 프록시를 쓰면 비워 둔다.
CLOUDFLARE_TUNNEL_TOKEN=

# --- GitHub App (GUIDE-V2-07부터 쓰인다) ---
# 등록 절차는 docs/GITHUB-APP-SETUP.md. 값이 비어 있으면 GitHub 화면이 아예 뜨지 않는다.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# .pem 파일 내용을 한 줄로. 줄바꿈 자리에 
 을 넣는다.
GITHUB_APP_PRIVATE_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_KEY=

# discord_service의 설정은 이 파일에 없다. `.env.discord.example` → `.env.discord`를 쓴다.
# Discord 봇 토큰과 CORE_TOKEN이 web 프로세스의 환경에까지 들어가지 않게 나눠 둔 것이다.
